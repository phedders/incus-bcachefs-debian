+
+	usage := ""
+	if c.os.args.SupportsRemote {
+		usage = "[<remote>:]"
+	}
+
+	if c.entity != "" {
+		description = "Show " + c.entity + " details"
+		usage += "<" + c.entityShort + ">"
+	}
+
+	if c.description != "" {
+		description = c.description
+	}
+
+	if c.name != "" {
+		name = c.name
+	}
+
+	cmd := &cobra.Command{}
