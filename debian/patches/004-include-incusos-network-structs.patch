+		}
+	}
+
+	if cpu.Frequency > 0 {
+		if cpu.FrequencyTurbo > 0 && cpu.FrequencyMinimum > 0 {
+			_, _ = fmt.Printf(prefix+"Frequency: %vMhz (min: %vMhz, max: %vMhz)\n", cpu.Frequency, cpu.FrequencyMinimum, cpu.FrequencyTurbo) //nolint:forbidigo
