 internal/server/instance/drivers/driver_common.go |  4 ++++
 internal/server/instance/drivers/driver_lxc.go    |  8 +++++---
 internal/server/sys/os.go                         | 12 ++++++++++++
 3 files changed, 21 insertions(+), 3 deletions(-)

