+++ b/internal/server/instance/drivers/driver_common.go
@@ -1091,6 +1091,10 @@ func (d *common) recordLastState() error {
 }
 
 func (d *common) setCoreSched(pids []int) error {
+	if !d.state.OS.CoreScheduling {
+		return nil
+	}
+
 	args := []string{
 		"forkcoresched",
 		"0",
