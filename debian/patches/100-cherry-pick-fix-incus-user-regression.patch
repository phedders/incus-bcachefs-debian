Subject: [PATCH 2/2] incus-user: Serialize user setup across connections
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 cmd/incus-user/main_daemon.go | 1 +
 cmd/incus-user/proxy.go       | 6 +++++-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/cmd/incus-user/main_daemon.go b/cmd/incus-user/main_daemon.go
index 8b7b8068f29..d1453d13193 100644
--- a/cmd/incus-user/main_daemon.go
+++ b/cmd/incus-user/main_daemon.go
@@ -22,6 +22,7 @@ var (
 	mu           sync.RWMutex
 	connections  uint64
 	transactions uint64
+	setupMu      sync.Mutex
 )
 
 var projectNames []string
diff --git a/cmd/incus-user/proxy.go b/cmd/incus-user/proxy.go
index ed1977f8fa1..0809e95bd89 100644
--- a/cmd/incus-user/proxy.go
+++ b/cmd/incus-user/proxy.go
@@ -81,16 +81,20 @@ func proxyConnection(conn *net.UnixConn, serverUnixPath string) {
 	logger.Debug("Connected")
 	defer logger.Debug("Disconnected")
 
-	// Check if the user was setup.
+	// Check if the user was setup, under a lock as concurrent connections would otherwise race on the setup.
+	setupMu.Lock()
 	if !util.PathExists(internalUtil.VarPath("users", fmt.Sprintf("%d", creds.Uid))) || !slices.Contains(projectNames, fmt.Sprintf("user-%d", creds.Uid)) {
 		log.Infof("Setting up for uid %d", creds.Uid)
 		err := serverSetupUser(creds.Uid)
 		if err != nil {
+			setupMu.Unlock()
 			log.Errorf("Failed to setup new user: %v", err)
 			return
 		}
 	}
 
+	setupMu.Unlock()
+
 	// Connect to the daemon.
 	unixAddr, err := net.ResolveUnixAddr("unix", serverUnixPath)
 	if err != nil {
